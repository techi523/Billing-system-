# Production Environment Variables Template

# APP
PORT=3000
NODE_ENV=production
JWT_SECRET=your_super_secure_random_string_here

# DATABASE
DB_TYPE=mysql
DB_HOST=localhost
DB_NAME=hotspot_saas_db
DB_USER=production_user
DB_PASS=production_password

# MPESA (PRODUCTION)
MPESA_ENV=production
MPESA_CALLBACK_BASE_URL=https://api.yourdomain.com
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=123456
MPESA_PASSKEY=your_lipa_na_mpesa_passkey

# SECURITY
CORS_ORIGIN=https://portal.yourdomain.com,https://admin.yourdomain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# SMS CREDITS SYSTEM
# REQUIRED in production: 64-character hex string (32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMS_ENCRYPTION_KEY=your_64_char_hex_string_here_replace_this_in_production
