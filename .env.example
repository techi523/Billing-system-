# Environment Configuration Template
# Copy this file to .env and fill in your values

# APP
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
SUPER_ADMIN_JWT_SECRET=your_super_admin_jwt_secret_here
SUPER_ADMIN_EMAIL=draviotech@gmail.com
SUPER_ADMIN_PASSWORD=your_secure_password_here

# DATABASE
# DB_TYPE=sqlite  (for development)
# DB_TYPE=mysql   (for production)
DB_TYPE=sqlite
DB_HOST=localhost
DB_NAME=hotspot_saas_db
DB_USER=root
DB_PASS=

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# INTASEND (Payment Gateway)
INTASEND_PUBLISHABLE_KEY=your_intasend_publishable_key
INTASEND_SECRET_KEY=your_intasend_secret_key
INTASEND_MOCK=true
INTASEND_ENV=sandbox

# MPESA (Daraja API - optional for development)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_lipa_na_mpesa_passkey

# RATE LIMITING (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
